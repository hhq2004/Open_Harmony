{
  "name": "openharmony-p07",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "P07 host-side contracts, prediction baseline and development pipeline",
  "engines": { "node": ">=22 <23" },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node scripts/build.mjs",
    "predemo": "npm run build",
    "demo": "node scripts/demo.mjs",
    "sync:harmony": "node scripts/sync-harmony.mjs",
    "build:harmony": "pwsh -NoProfile -File scripts/build-harmony.ps1",
    "pretest": "npm run build",
    "test": "node --test",
    "prereplay": "npm run build",
    "replay": "node benchmarks/replay.mjs",
    "preevaluate:prediction": "npm run build",
    "evaluate:prediction": "node benchmarks/prediction.mjs",
    "presweep:prediction": "npm run build",
    "sweep:prediction": "node benchmarks/sweep.mjs",
    "preverify:preload": "npm run build",
    "verify:preload": "node benchmarks/preload.mjs",
    "preverify:measurement": "npm run build",
    "verify:measurement": "node benchmarks/measurement.mjs",
    "test:coverage": "npm run build && node --test --experimental-test-coverage",
    "pipeline": "node scripts/pipeline.mjs"
  },
  "devDependencies": { "typescript": "5.9.3" }
}
